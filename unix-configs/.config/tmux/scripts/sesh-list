#!/usr/bin/env bash

set -euo pipefail

projects_root="$HOME/Projects"

# Sesh emits tmux sessions in descending session-activity order.
sesh list --tmux --icons

[[ -d "$projects_root" ]] || exit 0

shopt -s dotglob nullglob
projects=("$projects_root"/*)
((${#projects[@]} > 0)) || exit 0

active_paths="$(tmux list-sessions -F '#{session_path}' 2>/dev/null || true)"
while IFS= read -r project; do
  [[ -d "$project" ]] || continue
  if ! grep -Fqx -- "$project" <<<"$active_paths"; then
    printf '~/%s\n' "${project#"$HOME"/}"
  fi
done < <(printf '%s\n' "${projects[@]}" | LC_ALL=C sort -f)
