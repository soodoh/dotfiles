#!/usr/bin/env node

import { lstat, open, readFile, readdir } from "node:fs/promises";
import { isAbsolute, join } from "node:path";
import { spawnSync } from "node:child_process";
import {
	applyPaneOrder,
	buildRows,
	emptyCandidate,
	FIELD_SEPARATOR,
	getStateDirectory,
	heartbeatServerKey,
	MAX_HEARTBEAT_BYTES,
	parseProcessTable,
	parseTmuxPanes,
	rowToCandidate,
} from "./pi-session-lib.mjs";

const TMUX_FORMAT = [
	"#{pane_id}",
	"#{pane_pid}",
	"#{pane_tty}",
	"#{session_id}",
	"#{session_name}",
	"#{window_id}",
	"#{window_index}",
	"#{pane_index}",
	"#{pane_current_command}",
	"#{socket_path}",
	"#{pid}",
	"#{window_activity}",
	"#{pane_title}",
].join(FIELD_SEPARATOR);

const run = (command, args) => {
	const result = spawnSync(command, args, {
		encoding: "utf8",
		env: { ...process.env, LC_ALL: "C" },
		maxBuffer: 4 * 1024 * 1024,
	});
	return result.status === 0 ? result.stdout : "";
};

const branchCache = new Map();
const gitBranchForCwd = (cwd) => {
	if (branchCache.has(cwd)) return branchCache.get(cwd);
	const branch =
		run("git", ["-C", cwd, "symbolic-ref", "--quiet", "--short", "HEAD"]).trim() ||
		run("git", ["-C", cwd, "rev-parse", "--short", "HEAD"]).trim();
	branchCache.set(cwd, branch);
	return branch;
};

const readHeartbeats = async (panes) => {
	const directory = getStateDirectory();
	const serverKeys = new Set(
		panes.map((pane) => heartbeatServerKey(pane.socketPath, pane.serverPid)),
	);
	let entries;
	try {
		entries = await readdir(directory, { withFileTypes: true });
	} catch {
		return [];
	}

	const candidates = [];
	for (const entry of entries) {
		if (
			!entry.isFile() ||
			!entry.name.endsWith(".json") ||
			![...serverKeys].some((key) => entry.name.startsWith(`${key}-pane-`))
		) {
			continue;
		}
		const filePath = join(directory, entry.name);
		try {
			const stats = await lstat(filePath);
			if (
				!stats.isFile() ||
				stats.isSymbolicLink() ||
				stats.size > MAX_HEARTBEAT_BYTES
			) {
				continue;
			}
			candidates.push({ filePath, modifiedAt: stats.mtimeMs });
		} catch {
			// Files may disappear while Pi processes shut down.
		}
	}

	const records = [];
	for (const candidate of candidates
		.sort((left, right) => right.modifiedAt - left.modifiedAt)
		.slice(0, 1_024)) {
		try {
			const contents = await readFile(candidate.filePath, "utf8");
			if (Buffer.byteLength(contents) > MAX_HEARTBEAT_BYTES) continue;
			records.push(JSON.parse(contents));
		} catch {
			// One corrupt or disappearing heartbeat must not hide healthy panes.
		}
	}
	return records;
};

const MAX_SESSION_HEADER_BYTES = 4 * 1024;

const readSessionStartedAt = async (filePath) => {
	if (
		typeof filePath !== "string" ||
		filePath.length > 1_024 ||
		!isAbsolute(filePath)
	) {
		return undefined;
	}
	try {
		const stats = await lstat(filePath);
		if (!stats.isFile() || stats.isSymbolicLink()) return undefined;
		const handle = await open(filePath, "r");
		try {
			const buffer = Buffer.alloc(MAX_SESSION_HEADER_BYTES);
			const { bytesRead } = await handle.read(buffer, 0, buffer.length, 0);
			const firstLine = buffer.toString("utf8", 0, bytesRead).split("\n", 1)[0];
			if (!firstLine) return undefined;
			const parsed = JSON.parse(firstLine);
			const startedAt = Date.parse(parsed?.timestamp);
			return Number.isFinite(startedAt) && startedAt >= 0
				? startedAt
				: undefined;
		} finally {
			await handle.close();
		}
	} catch {
		return undefined;
	}
};

const hydrateSessionStartedAt = async (heartbeats, panes) => {
	const paneIds = new Set(panes.map((pane) => pane.paneId));
	const cache = new Map();
	const hydrated = [];
	for (const heartbeat of heartbeats) {
		if (
			Number.isFinite(heartbeat?.sessionStartedAt) ||
			!paneIds.has(heartbeat?.tmuxPaneId)
		) {
			hydrated.push(heartbeat);
			continue;
		}
		const filePath = heartbeat?.piSessionFile;
		if (!cache.has(filePath)) {
			cache.set(filePath, await readSessionStartedAt(filePath));
		}
		const sessionStartedAt = cache.get(filePath);
		hydrated.push(
			sessionStartedAt === undefined
				? heartbeat
				: { ...heartbeat, sessionStartedAt },
		);
	}
	return hydrated;
};

const readPaneOrder = async (filePath) => {
	if (!filePath) return [];
	try {
		const stats = await lstat(filePath);
		if (!stats.isFile() || stats.isSymbolicLink() || stats.size > 16 * 1024) {
			return [];
		}
		const contents = await readFile(filePath, "utf8");
		return contents
			.split("\n")
			.filter((paneId) => /^%[0-9]+$/.test(paneId))
			.slice(0, 1_024);
	} catch {
		return [];
	}
};

const orderFileIndex = process.argv.indexOf("--order-file");
const paneOrder = await readPaneOrder(
	orderFileIndex >= 0 ? process.argv[orderFileIndex + 1] : undefined,
);

const clientNameIndex = process.argv.indexOf("--client-name");
const clientName =
	clientNameIndex >= 0 ? process.argv[clientNameIndex + 1] : undefined;
const clientWidth = Number(
	clientName
		? run("tmux", [
				"display-message",
				"-p",
				"-c",
				clientName,
				"#{client_width}",
			]).trim()
		: "",
);
let displayWidth;
if (Number.isSafeInteger(clientWidth) && clientWidth > 0) {
	const popupWidth = Math.floor(clientWidth * 0.9);
	displayWidth = Math.max(1, popupWidth - Math.floor(popupWidth * 0.55) - 6);
}

const tmuxOutput = run("tmux", ["list-panes", "-a", "-F", TMUX_FORMAT]);
const panes = parseTmuxPanes(tmuxOutput);
const processOutput = run("ps", [
	"-A",
	"-o",
	"pid=",
	"-o",
	"ppid=",
	"-o",
	"pgid=",
	"-o",
	"tpgid=",
	"-o",
	"tty=",
	"-o",
	"lstart=",
]);
const heartbeats = await hydrateSessionStartedAt(
	await readHeartbeats(panes),
	panes,
);
let rows = buildRows({
	panes,
	heartbeats,
	processes: parseProcessTable(processOutput),
	now: Date.now(),
	branchForCwd: gitBranchForCwd,
	displayWidth,
});
if (paneOrder.length > 0) rows = applyPaneOrder(rows, paneOrder);

const validateIndex = process.argv.indexOf("--validate");
if (validateIndex >= 0) {
	const [paneId, sessionId, windowId] = process.argv.slice(validateIndex + 1);
	const valid = rows.some(
		(row) =>
			row.paneId === paneId &&
			row.sessionId === sessionId &&
			row.windowId === windowId,
	);
	process.exit(valid ? 0 : 1);
}

process.stdout.write(
	`${rows.length > 0 ? rows.map(rowToCandidate).join("\n") : emptyCandidate()}\n`,
);
