#!/usr/bin/env python3
"""Run Herdr in a PTY and shrink its pane-image traffic for a slow SSH link.

Herdr's SSH client path sends every pane-image repaint as a whole raw RGBA
upload. This proxy rewrites that Kitty graphics output:

- compresses uploads with zlib (`o=z`);
- with HERDR_IMAGE_SCALE=N, reports character cells N times smaller in pixels
  to Herdr, so pane images (such as terminal-browser) render at 1/N density
  and the terminal stretches them over the same cells; pixel mouse reports and
  cell-size replies are scaled to match;
- queues each frame unencoded and drops it if a newer frame for the same image
  arrives first; a frame is encoded only when it is about to be written,
  against what the terminal shows at that moment;
- sends a frame that changes only part of an image as a partial edit of the
  image on screen (`a=f`), unless HERDR_PARTIAL_IMAGES=0;
- with HERDR_SCROLL_COPY=1, reuses vertically shifted pixels using Kitty
  frame composition (`a=c`) and uploads only the repairs;
- while frames arrive faster than the link carries them (scrolling, loading),
  sends large changes in a coarser form, then a sharp edit once motion stops;
- keeps a hidden image's pixels in the terminal, so showing it again is an
  edit rather than a whole upload;
- holds large image updates until the terminal answers a status request sent
  after earlier ones, unless HERDR_FRAME_ACK=0.
"""

import array
import base64
import collections
import errno
import fcntl
import os
import pty
import re
import select
import signal
import struct
import sys
import termios
import time
import tty
import zlib

APC = b"\x1b_G"
ST = b"\x1b\\"
CHUNK = 4096
# Queued frames that a newer one replaces are dropped, so only other output can
# build up. Pause reads from Herdr if it ever exceeds this.
MAX_PENDING = 8 << 20
# Send a whole frame instead of an edit once this share of the image changed.
EDIT_LIMIT = 0.6
# Herdr sends delete then upload; a held delete with no upload behind it within
# this time goes out on its own.
HOLD_SECONDS = 0.05
# After each image update, ask the terminal for a status report; send the next
# image only once it answers, so at most one frame waits in network buffers.
PING = b"\x1b[5n"
PONG = b"\x1b[0n"
# Unanswered image bytes allowed on the link before an update waits for a
# reply. Typing and other small edits go out at once; whole frames are paced.
WINDOW = 32 * 1024
# Hidden images whose pixels stay in the terminal; older ones are deleted.
MAX_HIDDEN = 4
# A terminal that has never answered within this long does not support status
# requests: stop pacing (but keep removing late replies).
PING_TIMEOUT = 2.0
# Once a terminal has answered, a reply can be slow while a burst drains; wait
# this long before sending anyway, but keep pacing.
SLOW_REPLY = 10.0
# An image is in motion for this long after a frame for it arrived while an
# earlier one was still queued or unanswered.
MOTION_HOLD = 0.3
# In motion, changes covering more than this share of an image are coarse.
MOTION_AREA = 0.25
# Coarse frames repeat each sampled pixel over a BLOCK x BLOCK square and keep
# the top COLOR_BITS of each channel, which roughly halves their size again.
BLOCK = 2
COLOR_BITS = 5
# A coarse image is redrawn sharply once no frame for it arrived for this long.
REFINE_DELAY = 0.25
# macOS discards unread PTY output when the child exits. If Herdr exits while
# reads are paused, its own terminal restore may be lost; reset the common modes.
RESTORE = (
    b"\x1b[?1049l\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?1016l"
    b"\x1b[?1004l\x1b[?2004l\x1b[?2026l\x1b[?25h\x1b[0m"
)
QUANTIZE = bytes(
    (value & (0xFF << (8 - COLOR_BITS)) & 0xFF) | (0xFF >> COLOR_BITS if value & (0xFF << (8 - COLOR_BITS)) & 0xFF else 0)
    for value in range(256)
)


def controls(header):
    pairs = {}
    for part in header.split(b","):
        key, _, value = part.partition(b"=")
        if key:
            pairs[key] = value
    return pairs


def number(keys, key):
    try:
        return int(keys[key])
    except (KeyError, ValueError):
        return None


def first_difference(old, new):
    """Index of the first differing byte of two equal-length buffers."""
    low, high = 0, len(old)
    while high - low > 64:
        middle = (low + high) // 2
        if old[low:middle] == new[low:middle]:
            low = middle
        else:
            high = middle
    while old[low] == new[low]:
        low += 1
    return low


def last_difference(old, new):
    """Index of the last differing byte of two equal-length buffers."""
    low, high = 0, len(old)
    while high - low > 64:
        middle = (low + high) // 2
        if old[middle:high] == new[middle:high]:
            high = middle
        else:
            low = middle
    high -= 1
    while old[high] == new[high]:
        high -= 1
    return high


def changed_rect(old, new, width, height, depth):
    """Bounding box (x, y, w, h) of differing pixels, or None if identical."""
    stride = width * depth
    old, new = memoryview(old), memoryview(new)
    rows = [y for y in range(height) if old[y * stride:(y + 1) * stride] != new[y * stride:(y + 1) * stride]]
    if not rows:
        return None
    left, right = stride, -1
    for y in rows:
        a, b = old[y * stride:(y + 1) * stride], new[y * stride:(y + 1) * stride]
        if a[:left] != b[:left]:
            left = first_difference(a, b)
        if a[right + 1:] != b[right + 1:]:
            right = last_difference(a, b)
    x0, x1 = left // depth, right // depth
    return x0, rows[0], x1 - x0 + 1, rows[-1] - rows[0] + 1


def coarse(raw, width, height, depth, block=BLOCK):
    """Lower-detail RGBA of the same size: pixel blocks, fewer color levels.

    Repeated pixels and rows compress far better, and keeping the size lets the
    terminal's image, placements and later edits stay as they are.
    """
    if depth != 4:
        return raw
    stride = width * 4
    view = memoryview(raw)
    rows = []
    for top in range(0, height, block):
        sampled = array.array("I", view[top * stride:(top + 1) * stride].cast("I")[::block].tobytes())
        line = array.array("I", bytes(len(sampled) * block * 4))
        for offset in range(block):
            line[offset::block] = sampled
        line = line.tobytes()[:stride]
        rows.append(line * min(block, height - top))
    return b"".join(rows).translate(QUANTIZE)


def crop(raw, width, depth, rect):
    x, y, w, h = rect
    stride = width * depth
    return b"".join(raw[(y + row) * stride + x * depth:(y + row) * stride + (x + w) * depth] for row in range(h))


def encode(control, raw):
    """Chunked, zlib-compressed Kitty command carrying raw pixels."""
    # Level 6 cuts a half-resolution text frame by about a fifth over level 1
    # for a few milliseconds of CPU; the link, not compression, is the limit.
    encoded = base64.b64encode(zlib.compress(raw, 6))
    chunks = [encoded[i:i + CHUNK] for i in range(0, len(encoded), CHUNK)] or [b""]
    output = []
    for index, chunk in enumerate(chunks):
        last = index == len(chunks) - 1
        head = control + b",o=z," if index == 0 else b""
        output.append(APC + head + (b"m=0" if last else b"m=1") + b";" + chunk + ST)
    return b"".join(output)


def scroll_overlap(before, after, width, height):
    """Find a likely vertical translation from distinctive central scanlines."""
    stride = width * 4
    # Headers may stay fixed, and the right edge may contain a scrollbar.
    def signatures(raw):
        view = memoryview(raw)
        return [zlib.crc32(view[i + stride // 4:i + stride * 3 // 4]) for i in range(0, len(raw), stride)]

    old, new = signatures(before), signatures(after)
    positions = collections.defaultdict(list)
    for y, signature in enumerate(old):
        positions[signature].append(y)
    votes = collections.Counter()
    for y, signature in enumerate(new):
        hits = positions.get(signature, ())
        if len(hits) <= 3:  # Repeated blank rows can outvote the page content.
            votes.update(src - y for src in hits if 0 < abs(src - y) <= height // 2)
    if not votes:
        return None
    shift, count = votes.most_common(1)[0]
    if count < max(8, height // 32):
        return None
    # Trim fixed chrome at the ends. These are only hints: every differing
    # pixel (even a hash collision) is corrected before publishing the result.
    matches = [y for y in range(max(0, -shift), min(height, height - shift)) if old[y + shift] == new[y]]
    top = matches[0]
    return top + shift, top, matches[-1] - top + 1


def repair_rects(predicted, raw, width, height):
    """Group similar adjacent row changes without merging narrow and wide edits."""
    stride = width * 4
    rect = None
    for y in range(height):
        a, b = predicted[y * stride:(y + 1) * stride], raw[y * stride:(y + 1) * stride]
        if a == b:
            continue
        x, end = first_difference(a, b) // 4, last_difference(a, b) // 4 + 1
        if rect is not None:
            left, top, w, h = rect
            merged_left, merged_width = min(left, x), max(left + w, end) - min(left, x)
            merged_height = y - top + 1
            if merged_width * merged_height * 4 <= (w * h + end - x) * 5:
                rect = merged_left, top, merged_width, merged_height
                continue
            yield rect
        rect = x, y, end - x, 1
    if rect is not None:
        yield rect


def encode_scroll(frame, base, budget):
    """Reuse the previous scroll content, degrading only expensive repairs."""
    width, height, _ = frame.pixels()
    overlap = scroll_overlap(base.raw, frame.raw, width, height)
    if overlap is None:
        return None
    src, dst, rows = overlap
    stride = width * 4

    def shifted(raw):
        return raw[:dst * stride] + raw[src * stride:(src + rows) * stride] + raw[(dst + rows) * stride:]

    # Match against the original content, not against earlier coarse patches.
    # Reuse those pixels and let idle refinement restore them to full detail.
    predicted = shifted(base.raw)
    repairs = list(repair_rects(predicted, frame.raw, width, height))
    if len(repairs) > 32 or sum(w * h for _, _, w, h in repairs) > EDIT_LIMIT * width * height:
        return None
    previous = base.shown
    image = frame.image
    # Clone the displayed frame into a gapless scratch frame (the seed pixel
    # matches the original). Ghostty rejects overlapping copies in one frame.
    # Repair off-screen, publish the result in one copy, and free the scratch.
    start = APC + b"a=f,i=%s,c=1,z=-1,x=0,y=0,s=1,v=1,f=32,X=1,q=2;" % image + base64.b64encode(previous[:4]) + ST
    copy = b"a=c,i=%s,r=%d,c=%d,x=0,y=%d,X=0,Y=%d,w=%d,h=%d,C=1,q=2;"
    start += APC + copy % (image, 1, 2, dst, src, width, rows) + ST
    publish = APC + copy % (image, 2, 1, 0, 0, 0, 0) + ST + APC + b"a=d,d=f,i=%s,r=2,q=2;" % image + ST
    patches = [(rect, crop(frame.raw, width, 4, rect)) for rect in repairs]

    def pack(patches):
        parts = [start]
        size = len(start) + len(publish)
        for (x, y, w, h), pixels in patches:
            control = b"a=f,i=%s,r=2,X=1,x=%d,y=%d,s=%d,v=%d,f=32,q=2" % (image, x, y, w, h)
            part = encode(control, pixels)
            size += len(part)
            if size > budget:
                return None
            parts.append(part)
        return b"".join([*parts, publish]) if size <= budget else None

    output, chosen = pack(patches), patches
    # Aim for small enough repairs to pipeline several scrolls over the RTT
    # window, while keeping the best pixels that meet that size.
    for block in (3, 4):
        if output is not None and len(output) <= budget // 3:
            break
        smaller = [(r, coarse(pixels, r[2], r[3], 4, block)) for r, pixels in patches]
        low_res = pack(smaller)
        if low_res is not None and (output is None or len(low_res) < len(output)):
            output, chosen = low_res, smaller
    if output is None:
        return None
    actual = bytearray(predicted if previous is base.raw else shifted(previous))
    for (x, y, w, h), pixels in chosen:
        for row in range(h):
            offset = (y + row) * stride + x * 4
            actual[offset:offset + w * 4] = pixels[row * w * 4:(row + 1) * w * 4]
    return output, frame.raw if actual == frame.raw else bytes(actual)


class Frame:
    """One unencoded image frame, encoded once it reaches the head of the queue."""

    def __init__(self, image, sequence, header, raw, width, height, depth, delete=None, refine=False):
        self.image, self.sequence, self.header = image, sequence, header
        self.raw, self.width, self.height, self.depth = raw, width, height, depth
        # Herdr's delete before this upload; dropped when the frame is an edit.
        self.delete = delete
        # A sharp redraw of a coarse image, never coarse itself.
        self.refine = refine
        # Encoded size is unknown until it is written; assume weak compression
        # so whole frames wait for replies and small edits do not.
        self.estimate = len(raw) // 4
        # Set once encoded; `shown` is then the pixels it leaves on screen.
        self.rendered = False
        self.scroll_checked = False
        self.scroll_delta = False
        self.shown = None

    def pixels(self):
        return self.width, self.height, self.depth


class ImageLifecycle:
    """Translate Herdr output into an ordered stream for a slow terminal link.

    New frames may replace unsent frames, but a started write must finish.
    Keep the latest source pixels separate from the pixels the terminal will
    have after the current write; edits and scroll copies use the latter.
    The caller drives I/O, wakes us on readiness or timeout, and forwards
    terminal input after we consume replies to our own status requests.
    """

    def __init__(self, partial=False, paced=False, window=WINDOW, scroll_copy=False):
        self.partial = partial
        self.scroll_copy = scroll_copy and partial
        self.buffer = b""
        self.upload = None
        self.passing = False
        self.sequence = 0
        self.current = {}  # Source sequence used to associate a placement with its frame.
        self.latest = {}  # Full-detail source pixels for refinement.
        self.held = None
        self.held_since = 0.0
        self.hidden = []
        self.segments = []
        self.offset = 0
        self.pending_bytes = 0
        self.started = {}  # Last sequence that started writing, so its placement survives.
        self.committed = {}  # Pixels the terminal will have once that write finishes.
        self.motion = {}
        self.arrived = {}
        self.blurred = set()
        self.paced = paced
        self.window = window
        # Scroll deltas can pipeline across a round trip without opening the
        # window for whole uploads. Individual deltas still fit within window.
        self.scroll_window = 2 * window
        # Status requests on the wire, oldest first: [ours, time sent, offset].
        self.requests = collections.deque()
        self.total = self.acked = 0
        self.answered = False

    def receive(self, data):
        """Accept the next bytes from Herdr, possibly ending mid-command."""
        self._enqueue(self._parse(data))

    def poll(self):
        """Return (can write, seconds until the next timer wakeup or None)."""
        writable = bool(self.pending_bytes and self._ready())
        waits = [self._refine_due()]
        if self.held is not None:
            waits.append(HOLD_SECONDS)
        if self.pending_bytes and not writable:
            waits.append(0.1)  # Recheck for an unanswered status request.
        return writable, min((wait for wait in waits if wait is not None), default=None)

    def tick(self):
        """Queue any due hides and sharp redraws before handling ready I/O."""
        self._enqueue(self._expire_hide())
        self._refine()

    def flush(self, send):
        """Drain queued output to a blocking writer; no more replies are read."""
        self.paced = False
        while self.pending_bytes:
            self.write(send)

    def _next_sequence(self):
        self.sequence += 1
        return self.sequence

    def _parse(self, data):
        # Segments are (bytes, tag); tagged segments carry kind, image ID,
        # sequence, and a Frame for uploads. They never leave the lifecycle.
        self.buffer += data
        output = []
        while True:
            start = self.buffer.find(APC)
            if start < 0:
                keep = 2 if self.buffer.endswith(APC[:2]) else 1 if self.buffer.endswith(APC[:1]) else 0
                self._text(output, self.buffer[:len(self.buffer) - keep])
                self.buffer = self.buffer[len(self.buffer) - keep:]
                break
            end = self.buffer.find(ST, start + len(APC))
            if end < 0:
                self._text(output, self.buffer[:start])
                self.buffer = self.buffer[start:]
                break
            self._text(output, self.buffer[:start])
            command = self.buffer[start + len(APC):end]
            self.buffer = self.buffer[end + len(ST):]
            self._graphics(output, command)
        return [segment for segment in output if segment[0] or (segment[1] and segment[1][0] == "frame")]

    def _text(self, output, data):
        if data:
            # Text between a delete and the next command means no upload follows.
            self._hide(output)
            output.append((data, None))

    def _hide(self, output):
        """Emit a held delete that no upload follows as a hide."""
        if self.held is None:
            return
        _, image = self.held
        self.held = None
        if image in self.hidden:
            self.hidden.remove(image)
        self.hidden.append(image)
        output.append((APC + b"a=d,d=i,i=" + image + b",q=2;" + ST, ("hide", image, self._next_sequence(), None)))
        while len(self.hidden) > MAX_HIDDEN:
            self._delete(output, self.hidden.pop(0))

    def _delete(self, output, image, command=None):
        """Really delete an image; the next frame for it is a whole upload."""
        command = command or b"a=d,d=I,i=" + image + b",q=2;"
        output.append((APC + command + ST, ("release", image, self._next_sequence(), None)))

    def _expire_hide(self):
        """Release a delete held longer than HOLD_SECONDS; returns segments."""
        if self.held is None or time.monotonic() - self.held_since < HOLD_SECONDS:
            return []
        if self.buffer or (self.upload is not None and controls(self.upload[0]).get(b"i") == self.held[1]):
            # The command or upload behind it is still streaming in from Herdr.
            return []
        output = []
        self._hide(output)
        return output

    def finish(self, trailer=b""):
        """Queue any remaining input bytes and an optional terminal reset."""
        output = []
        self._hide(output)
        if self.upload is not None:
            output.append((self._passthrough(*self.upload), None))
            self.upload = None
        if self.buffer:
            output.append((self.buffer, None))
            self.buffer = b""
        self._enqueue([(b"".join(segment for segment, _ in output) + trailer, None)])

    def _graphics(self, output, command):
        header, _, payload = command.partition(b";")
        keys = controls(header)
        more = keys.get(b"m") == b"1"
        continuation = set(keys) <= {b"m", b"q"}
        if self.passing:
            if continuation:
                # Continuations of an upload this filter does not rewrite.
                self.passing = more
                output.append((APC + command + ST, None))
                return
            self.passing = False
        if self.upload is not None:
            if continuation:
                self.upload[1].append(payload)
                if not more:
                    first, parts = self.upload
                    self.upload = None
                    self._transmit(output, first, b"".join(parts))
                return
            # Anything else ends the upload, so pass the partial one through.
            first, parts = self.upload
            self.upload = None
            self._hide(output)
            output.append((self._passthrough(first, parts), None))
        image = keys.get(b"i")
        if keys.get(b"a") == b"d" and keys.get(b"d") == b"I" and image is not None:
            self._hide(output)
            if self.partial:
                # Herdr deletes before re-uploading; an edit may replace both.
                self.held = (command, image)
                self.held_since = time.monotonic()
                return
            self._delete(output, image, command)
            return
        eligible = (
            keys.get(b"a", b"t") in (b"t", b"T")
            and keys.get(b"t", b"d") == b"d"
            and keys.get(b"f", b"32") in (b"24", b"32")
            and b"o" not in keys
        )
        if eligible:
            if more:
                self.upload = (header, [payload])
            else:
                self._transmit(output, header, payload)
            return
        self._hide(output)
        self.passing = more
        if keys.get(b"a") == b"p" and image is not None:
            output.append((APC + command + ST, ("place", image, self.current.get(image, 0), None)))
            return
        output.append((APC + command + ST, None))

    @staticmethod
    def _passthrough(header, parts):
        chunks = [APC + header + b";" + parts[0] + ST]
        chunks.extend(APC + b"m=1;" + part + ST for part in parts[1:])
        return b"".join(chunks)

    def _transmit(self, output, header, payload):
        try:
            raw = base64.b64decode(payload, validate=False)
        except ValueError:
            self._hide(output)
            output.append((APC + header + b";" + payload + ST, None))
            return
        keys = controls(header)
        width, height = number(keys, b"s"), number(keys, b"v")
        depth = 3 if keys.get(b"f") == b"24" else 4
        image = keys.get(b"i")
        header = b",".join(p for p in header.split(b",") if not p.startswith(b"m="))
        transmit_only = keys.get(b"a", b"t") == b"t"
        if image is None or not transmit_only or not width or not height or len(raw) != width * height * depth:
            self._hide(output)
            output.append((encode(header, raw), None))
            return
        if image in self.hidden:
            self.hidden.remove(image)
        delete = None
        if self.held is not None and self.held[1] == image:
            delete, self.held = self.held[0], None
        else:
            self._hide(output)
        sequence = self.current[image] = self._next_sequence()
        frame = Frame(image, sequence, header, raw, width, height, depth, delete)
        previous = self.latest.get(image)
        if previous is not None and previous[:3] == (width, height, depth):
            rect = changed_rect(previous[3], raw, width, height, depth)
            # A small change will be a small edit; gate it accordingly.
            frame.estimate = 64 if rect is None else rect[2] * rect[3] * depth // 4 + 64
        self.latest[image] = (width, height, depth, raw)
        output.append((b"", ("frame", image, sequence, frame)))

    @staticmethod
    def _length(entry):
        data, tag = entry
        if tag is not None and tag[0] == "frame" and not tag[3].rendered:
            return tag[3].estimate
        return len(data)

    def _enqueue(self, segments):
        now = time.monotonic()
        for data, tag in segments:
            if tag is not None and tag[0] == "frame":
                image = tag[1]
                if not tag[3].refine:
                    busy = any(t is not None and t[0] == "frame" and t[1] == image for _, t in self.segments)
                    if busy or any(ours for ours, _, _ in self.requests):
                        # Frames arrive faster than the link carries them.
                        self.motion[image] = now
                    self.arrived[image] = now
                self._supersede(image, tag[2])
            entry = [data, tag]
            self.segments.append(entry)
            self.pending_bytes += self._length(entry)

    def _supersede(self, image, sequence):
        started = self.started.get(image)
        for index, entry in enumerate(self.segments):
            tag = entry[1]
            if tag is None or tag[1] != image or tag[0] in ("release", "hide") or tag[2] in (started, sequence):
                continue
            if index == 0 and self.offset:
                continue
            self.pending_bytes -= self._length(entry)
            self.segments[index] = [b"", None]

    def _refine(self):
        """Queue sharp redraws of coarse images once their motion stops."""
        now = time.monotonic()
        for image in list(self.blurred):
            if now - self.arrived.get(image, 0) < REFINE_DELAY:
                continue
            if any(tag is not None and tag[0] == "frame" and tag[1] == image for _, tag in self.segments):
                continue
            self.blurred.discard(image)
            latest = self.latest.get(image)
            base = self.committed.get(image)
            if latest is None or base is None or base.pixels() != latest[:3]:
                continue
            frame = Frame(image, self._next_sequence(), b"", latest[3], *latest[:3], refine=True)
            self._enqueue([(b"", ("frame", image, frame.sequence, frame))])

    def _refine_due(self):
        """Seconds until a coarse image with nothing queued needs a sharp redraw."""
        queued = {tag[1] for _, tag in self.segments if tag is not None and tag[0] == "frame"}
        waiting = [image for image in self.blurred if image not in queued]
        if not waiting:
            return None
        now = time.monotonic()
        return max(0.0, min(REFINE_DELAY - (now - self.arrived.get(image, 0)) for image in waiting))

    def _render(self, frame):
        """Encode a frame against what the terminal shows when it is written."""
        image, (width, height, depth) = frame.image, frame.pixels()
        base = self.committed.get(image)
        base = base.shown if base is not None and base.pixels() == frame.pixels() else None
        raw = frame.raw
        if self.partial and base is None and frame.refine:
            # The image was deleted meanwhile; nothing to sharpen.
            frame.shown = None
            return b""
        rect = changed_rect(base, raw, width, height, depth) if base is not None else None
        moving = (
            self.partial and not frame.refine
            and time.monotonic() - self.motion.get(image, -MOTION_HOLD) < MOTION_HOLD
            and (base is None or (rect is not None and rect[2] * rect[3] > MOTION_AREA * width * height))
        )
        if moving:
            raw = coarse(raw, width, height, depth)
            rect = changed_rect(base, raw, width, height, depth) if base is not None else None
        frame.shown = raw
        small = rect is None or rect[2] * rect[3] <= EDIT_LIMIT * width * height
        if self.partial and base is not None and (small or frame.refine):
            if rect is None:
                return b""
            x, y, w, h = rect
            control = b"a=f,i=%s,r=1,X=1,x=%d,y=%d,s=%d,v=%d,f=%d,q=2" % (image, x, y, w, h, depth * 8)
            return encode(control, crop(raw, width, depth, rect))
        if frame.refine:
            # A refine never re-creates an image; it only edits one on screen.
            frame.shown = None
            return b""
        delete = APC + frame.delete + ST if frame.delete else b""
        return delete + encode(frame.header, raw)

    def _begin(self, tag):
        if tag is None:
            return
        kind, image, sequence, frame = tag
        self.started[image] = sequence
        if kind == "release":
            self.committed.pop(image, None)
            self.blurred.discard(image)
        elif kind == "frame" and frame.shown is not None:
            self.committed[image] = frame
            if frame.shown is not frame.raw:
                self.blurred.add(image)
            else:
                self.blurred.discard(image)
        elif kind == "frame" and frame.rendered and not frame.refine:
            # A whole upload with unknown result; never edit against stale pixels.
            self.committed.pop(image, None)

    def _waiting(self, size, window):
        """Whether a `size`-byte image update must wait for earlier replies."""
        for ours, sent, _ in self.requests:
            if ours:
                age = time.monotonic() - sent
                if not self.answered and age >= PING_TIMEOUT:
                    # This terminal does not answer; stop pacing.
                    self.paced = False
                    return False
                if age >= SLOW_REPLY:
                    return False
                return self.total - self.acked + size > window
        return False

    def _gated(self, index):
        entry = self.segments[index]
        tag = entry[1]
        return (
            self.paced and not self.offset and tag is not None and tag[0] == "frame"
            and self._waiting(self._length(entry), self.scroll_window if tag[3].scroll_delta else self.window)
        )

    def _scroll_base(self, frame):
        if (not self.scroll_copy or frame.scroll_checked or frame.refine or frame.depth != 4
                or frame.estimate * 16 < len(frame.raw) or self.window <= 0):
            return None
        base = self.committed.get(frame.image)
        if base is not None and base.pixels() == frame.pixels():
            return base
        return None

    def _ready(self):
        """Whether write() can make progress now."""
        for index, (data, tag) in enumerate(self.segments):
            if tag is not None and tag[0] == "frame" and not tag[3].rendered:
                if not self._gated(index):
                    return True
                # A frame that looks large may really be a small scroll delta.
                return self._scroll_base(tag[3]) is not None and not self._waiting(1, self.scroll_window)
            if data:
                return not self._gated(index)
        return True

    def terminal_input(self, data):
        """Remove replies to our status requests from terminal input."""
        if PONG not in data or not self.requests:
            return data
        output, start = [], 0
        while (found := data.find(PONG, start)) >= 0 and self.requests:
            ours, _, offset = self.requests.popleft()
            if ours:
                self.acked = offset
                self.answered = True
            output.append(data[start:found] if ours else data[start:found + len(PONG)])
            start = found + len(PONG)
        output.append(data[start:])
        return b"".join(output)

    def _written(self, data, tag):
        """Record status requests in a segment that finished writing."""
        now = time.monotonic()
        if tag is None:
            # Herdr's own requests: their replies go back to Herdr.
            self.requests.extend([False, now, self.total] for _ in range(data.count(PING)))
        elif tag[0] == "frame" and data.endswith(PING) and self.paced:
            self.requests.append([True, now, self.total])

    def write(self, send):
        """Send bytes via a writer that returns the count accepted so far."""
        written = 0
        while self.segments:
            entry = self.segments[0]
            data, tag = entry
            if tag is not None and tag[0] == "frame" and not tag[3].rendered:
                frame = tag[3]
                gated = self._gated(0)
                scroll = None
                if (base := self._scroll_base(frame)) is not None and (not gated or not self._waiting(1, self.scroll_window)):
                    frame.scroll_checked = True
                    scroll = encode_scroll(frame, base, self.window - (len(PING) if self.paced else 0))
                if scroll is not None:
                    data, frame.shown = scroll
                    frame.scroll_delta = True
                elif gated:
                    break
                else:
                    data = self._render(frame)
                self.pending_bytes -= frame.estimate
                frame.rendered = True
                if data and self.paced:
                    data += PING
                entry[0] = data
                self.pending_bytes += len(data)
            if not self.offset and self._gated(0):
                break
            if self.offset >= len(data):
                if not data:
                    self._begin(tag)
                self.segments.pop(0)
                self.offset = 0
                continue
            remaining = len(data) - self.offset
            try:
                count = send(memoryview(data)[self.offset:])
            except (BlockingIOError, InterruptedError):
                break
            if count and not self.offset:
                self._begin(tag)
            self.offset += count
            self.pending_bytes -= count
            self.total += count
            written += count
            if count < remaining:
                break
            self._written(data, tag)
        return written


def scaled_size(size, scale):
    """A packed winsize with its pixel dimensions divided by `scale`."""
    rows, cols, width, height = struct.unpack("HHHH", size)
    return struct.pack("HHHH", rows, cols, width // scale, height // scale)


def copy_size(source, target, scale=1):
    try:
        size = fcntl.ioctl(source, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(target, termios.TIOCSWINSZ, scaled_size(size, scale))
    except OSError:
        pass


class InputScaler:
    """Divides pixel coordinates the terminal reports by the cell scale.

    Herdr sees cells `scale` times smaller in pixels than the terminal does, so
    SGR pixel mouse reports (mode 1016) and cell or window size replies
    (CSI 6/4 ; height ; width t) must shrink by the same factor.
    """

    REPORT = re.compile(rb"\x1b\[(<\d+;|[46];)(\d+);(\d+)([Mmt])")
    PARTIAL = re.compile(rb"\x1b(\[(<?[\d;]*)?)?$")

    def __init__(self, scale):
        self.scale = scale
        self.pixel_mouse = False
        self.pending = b""

    def output(self, data):
        """Track Herdr enabling or disabling SGR pixel mouse reports."""
        on, off = data.rfind(b"\x1b[?1016h"), data.rfind(b"\x1b[?1016l")
        if on > off:
            self.pixel_mouse = True
        elif off > on:
            self.pixel_mouse = False

    def input(self, data):
        if self.scale == 1:
            return data
        data = self.pending + data
        partial = self.PARTIAL.search(data)
        # Hold an unfinished report, but never a lone Escape key press.
        if partial and partial.group(0) != b"\x1b":
            self.pending, data = data[partial.start():], data[:partial.start()]
        else:
            self.pending = b""
        return self.REPORT.sub(self.replace, data)

    def replace(self, match):
        kind, first, second, final = match.groups()
        mouse = kind.startswith(b"<")
        if mouse and not self.pixel_mouse:
            return match.group(0)
        if mouse:
            # Mouse coordinates are 1-based pixels: x, then y.
            first, second = ((int(v) - 1) // self.scale + 1 for v in (first, second))
        else:
            first, second = (int(v) // self.scale for v in (first, second))
        return b"\x1b[" + kind + b"%d;%d" % (first, second) + final


def write_all(fd, data):
    view = memoryview(data)
    while view:
        try:
            written = os.write(fd, view)
        except InterruptedError:
            continue
        view = view[written:]


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: kitty-compress command [args...]")
    stdin = sys.stdin.fileno()
    stdout = sys.stdout.fileno()
    pid, master = pty.fork()
    if pid == 0:
        os.execvp(sys.argv[1], sys.argv[1:])
    interactive = os.isatty(stdin)
    scale = max(1, int(os.environ.get("HERDR_IMAGE_SCALE", "1") or 1))
    if interactive:
        copy_size(stdin, master, scale)
        saved = termios.tcgetattr(stdin)
        tty.setraw(stdin)
        signal.signal(signal.SIGWINCH, lambda *_: (copy_size(stdin, master, scale), os.kill(pid, signal.SIGWINCH)))
    scaler = InputScaler(scale)
    os.set_blocking(stdout, False)
    images = ImageLifecycle(
        partial=os.environ.get("HERDR_PARTIAL_IMAGES", "1") != "0",
        paced=os.environ.get("HERDR_FRAME_ACK", "1") != "0",
        scroll_copy=os.environ.get("HERDR_SCROLL_COPY") == "1",
    )

    def send(data):
        return os.write(stdout, data)

    stdin_open = True
    child_open = True
    paused = False
    try:
        while child_open or images.pending_bytes:
            # Keep forwarding keys and reading Herdr while a slow link drains,
            # so newer frames can replace stale queued ones.
            readers = [stdin] if stdin_open else []
            if child_open and images.pending_bytes < MAX_PENDING:
                readers.append(master)
            elif child_open:
                paused = True
            can_write, timeout = images.poll()
            writers = [stdout] if can_write else []
            try:
                readable, writable, _ = select.select(readers, writers, [], timeout)
            except InterruptedError:
                continue
            images.tick()
            if stdin in readable:
                try:
                    data = os.read(stdin, 1 << 16)
                except BlockingIOError:
                    data = None
                if data is None:
                    pass
                elif not data:
                    stdin_open = False
                else:
                    data = scaler.input(images.terminal_input(data))
                    if data:
                        write_all(master, data)
            if master in readable:
                try:
                    data = os.read(master, 1 << 16)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    data = b""
                if not data:
                    child_open = False
                    images.finish(RESTORE if paused else b"")
                else:
                    scaler.output(data)
                    images.receive(data)
                    paused = False
            if stdout in writable and images.pending_bytes:
                images.write(send)
    finally:
        os.set_blocking(stdout, True)
        images.flush(send)
        if interactive:
            termios.tcsetattr(stdin, termios.TCSAFLUSH, saved)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
