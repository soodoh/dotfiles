{
	"settings": {
		"autoAuth": true,
		"samplingAutoApprove": true
	},
	"mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"lifecycle": "lazy",
			"directTools": true
		},
		"mixpanel": {
			"url": "https://mcp.mixpanel.com/mcp",
			"auth": "oauth",
			"lifecycle": "lazy",
			"directTools": false
		},
		"playwright": {
			"command": "playwright-mcp",
			"args": ["--extension"],
			"lifecycle": "lazy"
		},
		"glean": {
			"url": "https://docusign-prod-be.glean.com/mcp/default",
			"auth": "oauth",
			"lifecycle": "lazy",
			"directTools": true
		},
		"azure-prod": {
			"command": "azmcp",
			"args": ["server", "start", "--read-only"],
			"env": {
				"HOME": "${HOME}/.azure/prod",
				"AZURE_CONFIG_DIR": "${HOME}/.azure/prod/.azure",
				"AZURE_SUBSCRIPTION_ID": "${AZURE_SUBSCRIPTION_ID}",
				"AZURE_TOKEN_CREDENTIALS": "AzureCliCredential",
				"PATH": "${PATH}",
				"NODE_OPTIONS": "${NODE_OPTIONS}",
				"NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}",
				"SSL_CERT_FILE": "${SSL_CERT_FILE}",
				"REQUESTS_CA_BUNDLE": "${REQUESTS_CA_BUNDLE}"
			},
			"inheritEnv": false,
			"lifecycle": "lazy",
			"directTools": false
		},
		"azure-devops": {
			"command": "mcp-server-azuredevops",
			"args": [
				"DocusignOrg",
				"--authentication",
				"pat",
				"--domains",
				"core",
				"--domains",
				"pipelines"
			],
			"env": {
				"NODE_OPTIONS": "${NODE_OPTIONS}",
				"NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}",
				"SSL_CERT_FILE": "${SSL_CERT_FILE}",
				"PERSONAL_ACCESS_TOKEN": "${ADO_MCP_PAT_BASIC}"
			},
			"inheritEnv": false,
			"includeTools": [
				"core_list_projects",
				"pipelines_build",
				"pipelines_build_log",
				"pipelines_definition",
				"pipelines_run",
				"pipelines_artifact"
			],
			"lifecycle": "lazy",
			"directTools": false
		},
		"figma": {
			"command": "figma-developer-mcp",
			"args": ["--stdio"],
			"env": {
				"FIGMA_API_KEY": "${FIGMA_API_KEY}"
			},
			"lifecycle": "lazy"
		}
	}
}
