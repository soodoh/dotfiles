{
  "lastChangelogVersion": "1.0.3",
  "defaultProvider": "cliproxyapi",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "tuiMode": "regular",
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "collapseChangelog": true,
  "quietStartup": true,
  "enableSkillCommands": true,
  "skills": [
    "~/.agents/skills/agent-browser/SKILL.md",
    "~/.acm/plugins/1ds/skills/ds-ui/SKILL.md",
    "~/.acm/plugins/1ds/skills/ds-tokens/SKILL.md",
    "~/.acm/plugins/1ds/skills/1ds-heimdall-usage/SKILL.md"
  ],
  "extensions": [
    "extensions/*.ts",
    "-extensions/herdr-agent-state.ts",
    "-extensions/moshi-hooks.ts"
  ],
  "packages": [
    {
      "source": "./pi-extensions",
      "extensions": [
        "packages/auto-session-name/index.ts",
        "packages/agent-state/index.ts",
        "packages/shared-prompt-history/index.ts",
        "packages/statusline/index.ts",
        "packages/aidev-track/index.ts",
        "node_modules/pi-vim/index.ts",
        "packages/cliproxyapi/index.ts",
        "node_modules/@plannotator/pi-extension",
        "node_modules/pi-web-access/index.ts",
        "node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
        "node_modules/pi-subagents/index.js"
      ]
    }
  ],
  "steeringMode": "all",
  "autoSessionName": {
    "titleModel": [
      "google-vertex/gemini-3.8-flash"
    ]
  },
  "enabledModels": [
    "cliproxyapi/gpt-6-astra",
    "cliproxyapi/gpt-6.1-sol",
    "cliproxyapi/gpt-6-luna",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/gpt-6-luna",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "google-vertex/gemini-3.8-flash"
  ]
}