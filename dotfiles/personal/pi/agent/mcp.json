{
	"settings": {
		"autoAuth": true,
		"samplingAutoApprove": true
	},
	"mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"lifecycle": "lazy",
			"directTools": true
		},
		"playwright": {
			"command": "playwright-mcp",
			"args": ["--extension"],
			"lifecycle": "lazy"
		}
	}
}
