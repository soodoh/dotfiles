{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "exposure": "direct"
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--extension"],
      "exposure": "codemode-deferred"
    }
  }
}
