{
  "name": "dotfiles",
  "author": "Paul DiLoreto <soodohh@pm.me>",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/soodoh/dotfiles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soodoh/dotfiles.git"
  },
  "description": "Dot files used in my personal developer environments across multiple OSs.",
  "scripts": {
    "check": "npm --prefix pi-extensions run check",
    "check:write": "npm --prefix pi-extensions run check:write",
    "ci": "npm --prefix pi-extensions run ci",
    "test": "npm --prefix pi-extensions run test",
    "test:coverage": "npm --prefix pi-extensions run test:coverage",
    "test:typecheck": "npm --prefix pi-extensions run test:typecheck",
    "typecheck": "npm --prefix pi-extensions run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "lefthook": "^2.1.10"
  }
}
