{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "dotfiles/common/nvim/lazy-lock.json",
    "dotfiles/personal/agents/**",
    "dotfiles/work/agents/**"
  ],
  "packageRules": [
    {
      "description": "Keep Grafana MCP's mise version unprefixed to match its lockfile",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["grafana/mcp-grafana"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "description": "Automerge lock maintenance and non-major updates after checks pass",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Isolate Python updates and allow time for standalone binaries to be published",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "groupName": "Python runtime",
      "groupSlug": "python-runtime",
      "minimumReleaseAge": "7 days"
    }
  ]
}
