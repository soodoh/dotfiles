{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep Node aligned with the Nix nodejs_24 runtime",
      "matchManagers": [
        "nvm"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": ">=24 <25"
    },
    {
      "description": "Update immutable Homebrew tap snapshots together",
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "https://github.com/Homebrew/homebrew-cask",
        "https://github.com/snowflakedb/homebrew-snowflake-cli"
      ],
      "groupName": "Homebrew taps"
    },
    {
      "description": "Update the Pi extension runtime closure atomically",
      "matchFileNames": [
        "pi-extensions/package.json"
      ],
      "groupName": "Pi extension dependency closure"
    },
    {
      "description": "Update the Biome package and schema together",
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "groupName": "Biome"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track custom Neovim plugins by default-branch commit",
      "managerFilePatterns": [
        "/^nix/modules/common/neovim\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: packageName=(?<packageName>\\S+) currentValue=(?<currentRef>\\S+)\\s+[\\s\\S]*?\\\"(?<currentDigest>[a-f0-9]{40})\\\""
      ],
      "currentValueTemplate": "{{{currentRef}}}",
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "github-digest"
    },
    {
      "customType": "regex",
      "description": "Track tools invoked by the generated dependency workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/generated-dependencies\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ]
    },
    {
      "customType": "regex",
      "description": "Track the Biome schema version",
      "managerFilePatterns": [
        "/^pi-extensions/biome\\.json$/"
      ],
      "matchStrings": [
        "https://biomejs\\.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)/schema\\.json"
      ],
      "depNameTemplate": "@biomejs/biome",
      "packageNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
