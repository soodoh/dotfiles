{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "dotfiles/common/nvim/lazy-lock.json",
    "dotfiles/personal/agents/**",
    "dotfiles/work/agents/**"
  ],
  "packageRules": [
    {
      "description": "Automerge lock maintenance and non-major updates after checks pass",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Isolate Pi extension updates from unrelated tools",
      "matchFileNames": ["pi-extensions/package.json"],
      "matchDepTypes": ["dependencies"],
      "groupName": "Pi extensions",
      "groupSlug": "pi-extensions",
      "separateMajorMinor": true
    },
    {
      "description": "Upgrade the Pi host and development SDK together",
      "matchPackageNames": [
        "@earendil-works/pi-agent-core",
        "@earendil-works/pi-ai",
        "@earendil-works/pi-coding-agent",
        "@earendil-works/pi-tui",
        "npm:@earendil-works/pi-coding-agent"
      ],
      "groupName": "Pi host and SDK",
      "groupSlug": "pi-host-and-sdk",
      "separateMajorMinor": true
    },
    {
      "description": "Isolate Python updates and allow time for standalone binaries to be published",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "groupName": "Python runtime",
      "groupSlug": "python-runtime",
      "minimumReleaseAge": "7 days"
    }
  ]
}
