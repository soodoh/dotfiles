{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "dotfiles/common/nvim/lazy-lock.json",
    "dotfiles/personal/agents/**",
    "dotfiles/work/agents/**"
  ],
  "packageRules": [
    {
      "description": "Automerge lock maintenance and non-major updates after checks pass",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
