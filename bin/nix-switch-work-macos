#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/lib/sudo-session.sh"
cd "$script_dir/.."
certificate_bundle="/Library/Application Support/DocuSign/zscaler-ca-bundle.pem"
if [ ! -r "$certificate_bundle" ]; then
  echo >&2 "Corporate certificate bundle is unavailable: $certificate_bundle"
  exit 1
fi
trusted_public_keys="cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs="
start_sudo_session
/usr/bin/sudo --set-home env \
  NIX_REMOTE=local \
  NIX_CONFIG="trusted-public-keys = $trusted_public_keys
ssl-cert-file = $certificate_bundle" \
  nix run .#darwin-rebuild -- \
  switch \
  --option trusted-public-keys "$trusted_public_keys" \
  --option ssl-cert-file "$certificate_bundle" \
  --flake .#work-macos
