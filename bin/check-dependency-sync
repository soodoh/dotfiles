#!/usr/bin/env node

const { readFileSync } = require("node:fs");
const { resolve } = require("node:path");

const repoRoot = resolve(__dirname, "..");
const readJson = (relativePath) =>
  JSON.parse(readFileSync(resolve(repoRoot, relativePath), "utf8"));

const rootManifest = readJson("package.json");
const rootLock = readJson("package-lock.json");
const extensionManifest = readJson("pi-extensions/package.json");
const extensionLock = readJson("pi-extensions/package-lock.json");
const biomeConfig = readJson("pi-extensions/biome.json");
const bundledPackages = extensionManifest.bundledPiPackages ?? [];
const bundledPackageSet = new Set(bundledPackages);
const extensionDependencies = extensionManifest.dependencies ?? {};
const rootLockRoot = rootLock.packages?.[""] ?? {};
const extensionLockRoot = extensionLock.packages?.[""] ?? {};
const rootToolingPackages = [
  "@commitlint/cli",
  "@commitlint/config-conventional",
  "@commitlint/types",
  "lefthook",
];
const errors = [];
const mcpProfiles = ["personal", "work"].map((profile) => {
  const packageRoot = `nix/packages/mcp-servers/${profile}`;
  return {
    profile,
    manifest: readJson(`${packageRoot}/package.json`),
    lock: readJson(`${packageRoot}/package-lock.json`),
    config: readJson(`nix/dotfiles/profiles/${profile}/.pi/agent/mcp.json`),
  };
});
const normalizeRecord = (record) => Object.fromEntries(Object.entries(record).sort(([a], [b]) => a.localeCompare(b)));

if (bundledPackageSet.size !== bundledPackages.length) {
  errors.push("bundledPiPackages contains duplicate package names");
}

for (const packageName of bundledPackages) {
  const declaration = extensionDependencies[packageName];
  if (declaration === undefined) {
    errors.push(`bundled Pi package ${packageName} is missing from dependencies`);
  } else if (
    !/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(declaration)
  ) {
    errors.push(`bundled Pi package ${packageName} must use an exact npm version, found ${declaration}`);
  }
}

const rootDevDependencies = rootManifest.devDependencies ?? {};
const lockedRootDevDependencies = rootLockRoot.devDependencies ?? {};
if (JSON.stringify(normalizeRecord(rootDevDependencies)) !== JSON.stringify(normalizeRecord(lockedRootDevDependencies))) {
  errors.push("root devDependencies do not match package-lock.json");
}

const extensionDevDependencies = extensionManifest.devDependencies ?? {};
for (const packageName of rootToolingPackages) {
  if (!Object.hasOwn(rootDevDependencies, packageName)) {
    errors.push(`root tooling dependency ${packageName} is missing from root devDependencies`);
  }
  if (Object.hasOwn(extensionDevDependencies, packageName)) {
    errors.push(`root tooling dependency ${packageName} must not be declared by pi-extensions`);
  }
}

for (const dependencyType of ["dependencies", "devDependencies", "peerDependencies"]) {
  const declared = extensionManifest[dependencyType] ?? {};
  const locked = extensionLockRoot[dependencyType] ?? {};
  if (JSON.stringify(normalizeRecord(declared)) !== JSON.stringify(normalizeRecord(locked))) {
    errors.push(`pi-extensions ${dependencyType} do not match package-lock.json`);
  }
}

for (const { profile, manifest, lock, config } of mcpProfiles) {
  const dependencies = manifest.dependencies ?? {};
  const commands = manifest.mcpCommands ?? {};
  const lockedDependencies = lock.packages?.[""]?.dependencies ?? {};
  const configuredCommands = Object.values(config.mcpServers ?? {})
    .map((server) => server.command)
    .filter((command) => command !== undefined);

  if (JSON.stringify(normalizeRecord(dependencies)) !== JSON.stringify(normalizeRecord(lockedDependencies))) {
    errors.push(`${profile} MCP dependencies do not match package-lock.json`);
  }
  for (const [command, npmCommand] of Object.entries(commands)) {
    if (!configuredCommands.includes(command)) {
      errors.push(`${profile} MCP package command ${command} is not used by mcp.json`);
    }
    if (typeof npmCommand !== "string" || npmCommand.length === 0) {
      errors.push(`${profile} MCP package command ${command} has no npm executable`);
    }
  }
  for (const command of configuredCommands) {
    if (command === "npx") {
      errors.push(`${profile} mcp.json still uses mutable npx execution`);
    } else if (!(command in commands)) {
      errors.push(`${profile} mcp.json command ${command} is not installed by its MCP package`);
    }
  }
}

const biomeDeclaration = extensionManifest.devDependencies?.["@biomejs/biome"];
const biomeDependencyVersion = biomeDeclaration?.replace(/^[~^]/, "");
const biomeSchemaMatch = biomeConfig.$schema?.match(
  /^https:\/\/biomejs\.dev\/schemas\/(\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)\/schema\.json$/,
);

if (!biomeDependencyVersion) {
  errors.push("pi-extensions @biomejs/biome dependency is missing");
} else if (!/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/.test(biomeDependencyVersion)) {
  errors.push(`pi-extensions @biomejs/biome dependency has an unsupported range: ${biomeDeclaration}`);
} else if (!biomeSchemaMatch) {
  errors.push(`Biome schema URL is not version-pinned: ${biomeConfig.$schema}`);
} else if (biomeSchemaMatch[1] !== biomeDependencyVersion) {
  errors.push(
    `Biome schema version ${biomeSchemaMatch[1]} does not match dependency ${biomeDependencyVersion}`,
  );
}

if (errors.length > 0) {
  console.error("Dependency synchronization validation failed:");
  for (const error of errors) {
    console.error(`- ${error}`);
  }
  process.exit(1);
}

console.log("Pi extension and MCP dependencies are synchronized");
