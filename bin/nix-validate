#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
./bin/check-dependency-sync
nix fmt -- --ci --tree-root . --walk filesystem
nix run .#statix -- check .
nix run .#deadnix -- --fail .
nix flake check --all-systems --no-build
current_system="$(nix eval --impure --raw --expr builtins.currentSystem)"
case "$current_system" in
  *-darwin)
    nix build --no-link \
      .#darwinConfigurations.personal-macos.system \
      .#darwinConfigurations.work-macos.system
    ;;
  *-linux)
    nix build --no-link \
      .#homeConfigurations.personal-arch.activationPackage \
      .#homeConfigurations.personal-debian.activationPackage
    ;;
  *)
    echo >&2 "unsupported validation system: $current_system"
    exit 2
    ;;
esac
nix build --no-link ".#packages.$current_system".{pi,twg,pi-extensions}
nix build --no-link ".#checks.$current_system".{immutable-plugin-policy,dotfile-targets,audit-legacy-discovery,cleanup-confirmation}
git diff --check
