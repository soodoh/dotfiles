#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export COREPACK_ENABLE_PROJECT_SPEC=1
corepack npm ci --dry-run --ignore-scripts --no-audit --no-fund >/dev/null
for profile in personal work; do
  (
    cd "nix/packages/mcp-servers/$profile"
    corepack npm ci --dry-run --ignore-scripts --no-audit --no-fund >/dev/null
  )
done
(
  cd pi-extensions
  corepack npm ci
  corepack npm run ci
)
nix fmt -- --ci --tree-root . --walk filesystem
nix run .#statix -- check .
nix run .#deadnix -- --fail .
nix flake check --all-systems --no-build
current_system="$(nix eval --impure --raw --expr builtins.currentSystem)"
case "$current_system" in
  *-darwin)
    nix build --no-link \
      .#darwinConfigurations.personal-macos.system \
      .#darwinConfigurations.work-macos.system \
      ".#checks.$current_system.comin-deployment-config" \
      ".#checks.$current_system.comin-darwin-activation"
    ;;
  *-linux)
    nix build --no-link \
      .#homeConfigurations.personal-arch.activationPackage \
      .#homeConfigurations.personal-debian.activationPackage
    ;;
  *)
    echo >&2 "unsupported validation system: $current_system"
    exit 2
    ;;
esac
nix build --no-link ".#packages.$current_system".{pi,twg,pi-extensions}
nix build --no-link ".#checks.$current_system".{immutable-plugin-policy,audit-external-state}
git diff --check
