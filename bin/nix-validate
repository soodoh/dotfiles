#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export COREPACK_ENABLE_PROJECT_SPEC=1
corepack npm ci --dry-run --ignore-scripts --no-audit --no-fund >/dev/null
(
  cd nix/packages/mcp-servers/work
  corepack npm ci --dry-run --ignore-scripts --no-audit --no-fund >/dev/null
)
(
  cd pi-extensions
  corepack npm ci
  corepack npm run ci
)
nix fmt -- --ci --tree-root . --walk filesystem
nix run .#statix -- check .
nix run .#deadnix -- --fail .
nix flake check --all-systems --no-build
current_system="$(nix eval --impure --raw --expr builtins.currentSystem)"
if [[ "$current_system" == *-darwin ]]; then
  nix build --no-link \
    .#darwinConfigurations.personal-macos.system \
    .#darwinConfigurations.work-macos.system
fi
nix build --no-link ".#packages.$current_system".{pi,twg,pi-extensions}
nix build --no-link ".#checks.$current_system".{immutable-plugin-policy,audit-external-state}
git diff --check
