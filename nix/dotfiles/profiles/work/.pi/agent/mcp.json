{
	"settings": {
		"autoAuth": true,
		"samplingAutoApprove": true
	},
	"mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			},
			"lifecycle": "lazy",
			"directTools": true
		},
		"mixpanel": {
			"url": "https://mcp.mixpanel.com/mcp",
			"auth": "oauth",
			"lifecycle": "lazy",
			"directTools": false
		},
		"playwright": {
			"command": "playwright-mcp",
			"args": ["--extension"],
			"lifecycle": "lazy"
		},
		"glean": {
			"url": "https://docusign-prod-be.glean.com/mcp/default",
			"auth": "oauth",
			"lifecycle": "lazy",
			"directTools": true
		},
		"azure": {
			"command": "azmcp",
			"args": ["server", "start"],
			"lifecycle": "lazy",
			"directTools": false
		},
		"kusto": {
			"command": "kusto-mcp",
			"lifecycle": "lazy",
			"directTools": false
		},
		"azure-devops": {
			"command": "mcp-server-azuredevops",
			"args": ["DocusignOrg"],
			"lifecycle": "lazy",
			"directTools": false
		},
		"figma": {
			"command": "figma-developer-mcp",
			"args": ["--stdio"],
			"env": {
				"FIGMA_API_KEY": "${FIGMA_API_KEY}"
			},
			"lifecycle": "lazy"
		}
	}
}
