{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./packages/auto-session-name/index.ts",
			"./packages/agent-state/index.ts",
			"./packages/shared-prompt-history/index.ts",
			"./packages/statusline/index.ts",
			"./packages/aidev-track/index.ts",
			"node_modules/pi-vim/index.ts",
			"node_modules/@router-for-me/pi-cliproxyapi-provider/extensions/index.ts",
			"node_modules/@plannotator/pi-extension/",
			"node_modules/pi-mcp-adapter/index.ts",
			"node_modules/pi-web-access/index.ts",
			"node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
			"node_modules/pi-subagents/index.js"
		],
		"skills": [
			"node_modules/pi-mcp-adapter/skills",
			"node_modules/pi-subagents/skills"
		],
		"prompts": [
			"node_modules/pi-subagents/prompts"
		]
	},
	"scripts": {
		"build": "tsc --noEmit",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"ci": "bun run ci:fast && bun run test:host",
		"ci:fast": "bun run check && bun run typecheck && bun run test:coverage",
		"test": "vitest run",
		"test:host": "node subagents-host.test.mjs",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"test:coverage:html": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html"
	},
	"dependencies": {
		"@juicesharp/rpiv-ask-user-question": "2.11.0",
		"@plannotator/pi-extension": "0.27.20",
		"@router-for-me/pi-cliproxyapi-provider": "1.4.19",
		"pi-mcp-adapter": "2.37.0",
		"pi-subagents": "0.71.0",
		"pi-vim": "0.14.2",
		"pi-web-access": "0.31.0",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.34"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@earendil-works/pi-agent-core": "0.87.1",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/node": "^26.6.2",
		"@types/proper-lockfile": "4.1.4",
		"@vitest/coverage-v8": "^5.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"bundleDependencies": [
		"pi-vim",
		"@router-for-me/pi-cliproxyapi-provider",
		"@plannotator/pi-extension",
		"pi-mcp-adapter",
		"pi-web-access",
		"@juicesharp/rpiv-ask-user-question",
		"pi-subagents"
	]
}
