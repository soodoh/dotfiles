{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./packages/auto-session-name/index.ts",
			"./packages/shared-prompt-history/index.ts",
			"./packages/statusline/index.ts",
			"./packages/aidev-track/index.ts",
			"./packages/tmux-session-status/index.ts",
			"node_modules/pi-vim/index.ts",
			"node_modules/pi-openai-fast/index.ts",
			"node_modules/@plannotator/pi-extension/",
			"node_modules/pi-mcp-adapter/index.ts",
			"node_modules/@juicesharp/rpiv-web-tools/index.ts",
			"node_modules/@juicesharp/rpiv-todo/index.ts",
			"node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
			"node_modules/pi-readseek/dist/index.ts",
			"node_modules/pi-subagents/index.ts",
			"node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts"
		],
		"skills": [
			"node_modules/pi-mcp-adapter/skills",
			"node_modules/pi-subagents/skills",
			"node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
			"node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
		],
		"prompts": [
			"node_modules/pi-subagents/prompts"
		]
	},
	"scripts": {
		"build": "tsc --noEmit",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"ci": "bun run check && bun run typecheck && bun run test:typecheck && bun run test:coverage",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:typecheck": "tsc --noEmit --project tsconfig.test.json",
		"typecheck": "tsc --noEmit",
		"test:coverage:html": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html"
	},
	"dependencies": {
		"@juicesharp/rpiv-ask-user-question": "2.6.4",
		"@juicesharp/rpiv-todo": "2.6.4",
		"@juicesharp/rpiv-web-tools": "2.6.4",
		"@plannotator/pi-extension": "0.27.4",
		"@quintinshaw/pi-dynamic-workflows": "3.7.0",
		"google-auth-library": "11.0.2",
		"pi-mcp-adapter": "2.26.1",
		"pi-openai-fast": "1.0.1",
		"pi-readseek": "0.9.13",
		"pi-subagents": "0.52.1",
		"pi-vim": "0.14.1",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.16"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "^26.2.0",
		"@types/proper-lockfile": "4.1.4",
		"@vitest/coverage-v8": "^4.1.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"bundleDependencies": [
		"pi-vim",
		"pi-openai-fast",
		"@plannotator/pi-extension",
		"pi-mcp-adapter",
		"@juicesharp/rpiv-web-tools",
		"@juicesharp/rpiv-todo",
		"@juicesharp/rpiv-ask-user-question",
		"pi-readseek",
		"pi-subagents",
		"@quintinshaw/pi-dynamic-workflows"
	]
}
