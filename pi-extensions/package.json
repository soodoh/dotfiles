{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@12.0.2",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./packages/auto-session-name/index.ts",
			"./packages/shared-prompt-history/index.ts",
			"./packages/statusline/index.ts",
			"./packages/aidev-track/index.ts",
			"./packages/tmux-session-status/index.ts"
		]
	},
	"scripts": {
		"build": "tsc --noEmit",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"ci": "npm run check && npm run typecheck && npm run test:typecheck && npm run test:coverage",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:typecheck": "tsc --noEmit --project tsconfig.test.json",
		"typecheck": "tsc --noEmit",
		"test:coverage:html": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html"
	},
	"dependencies": {
		"@juicesharp/rpiv-ask-user-question": "2.4.0",
		"@juicesharp/rpiv-todo": "2.4.0",
		"@juicesharp/rpiv-web-tools": "2.4.0",
		"@plannotator/pi-extension": "0.27.2",
		"@quintinshaw/pi-dynamic-workflows": "3.5.1",
		"pi-mcp-adapter": "2.25.0",
		"pi-openai-fast": "1.0.1",
		"pi-readseek": "0.9.13",
		"pi-subagents": "0.48.0",
		"pi-vim": "0.14.1",
		"proper-lockfile": "4.1.2",
		"typebox": "^1.3.13"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "^26.2.0",
		"@types/proper-lockfile": "4.1.4",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"bundledPiPackages": [
		"pi-vim",
		"pi-openai-fast",
		"@plannotator/pi-extension",
		"pi-mcp-adapter",
		"@juicesharp/rpiv-web-tools",
		"@juicesharp/rpiv-todo",
		"@juicesharp/rpiv-ask-user-question",
		"pi-readseek",
		"pi-subagents",
		"@quintinshaw/pi-dynamic-workflows"
	]
}
